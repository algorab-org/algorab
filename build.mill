//| mill-version: 1.1.8

import mill.*, scalalib.*, scalafmt.*

object versions:
  def scala: String = "3.9.0"

object `package` extends ScalaModule, ScalafmtModule:
  main =>

  def scalaVersion = versions.scala

  def mvnDeps = Seq(
    mvn"com.github.ghostdogpr::purelogic:0.3.0",
    mvn"io.github.iltotore::pureparser:1.0.0",
    mvn"io.github.iltotore::iron:3.3.2"
  )

  def scalacOptions = Seq(
    "-Wvalue-discard", 
    "-Wnonunit-statement",
    "-deprecation",
    "-Wconf:msg=(unused.*value|discarded.*value|pure.*statement):error",
    "-language:strictEquality"
  )

  object test extends ScalaTests, TestModule.Utest:

    def utestVersion = "0.10.0-RC1"

    def compileResources = resources

    def scalacOptions = main.scalacOptions()

  object cli extends ScalaModule, ScalafmtModule:
    
    def scalaVersion = versions.scala

    def scalacOptions = main.scalacOptions()

    def moduleDeps = Seq(main)

    def mvnDeps = Seq(
      mvn"com.lihaoyi::mainargs:0.7.8",
      mvn"com.lihaoyi::os-lib:0.11.8"
    )